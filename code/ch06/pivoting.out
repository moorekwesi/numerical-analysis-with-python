eps = 1e-04:  no pivoting x = [1.00010001 0.99989999],   with pivoting x = [1.00010001 0.99989999]
eps = 1e-08:  no pivoting x = [1.00000001 0.99999999],   with pivoting x = [1.00000001 0.99999999]
eps = 1e-12:  no pivoting x = [0.99997788 1.        ],   with pivoting x = [1. 1.]
eps = 1e-16:  no pivoting x = [2.22044605 1.        ],   with pivoting x = [1. 1.]
eps = 1e-20:  no pivoting x = [0. 1.],   with pivoting x = [1. 1.]
exact solution is x1 = 1/(1-eps) ~ 1, x2 = (1-2 eps)/(1-eps) ~ 1
